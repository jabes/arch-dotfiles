# =============================================================================
# NVIDIA VA-API (Hardware Video Decoding)
# https://github.com/elFarto/nvidia-vaapi-driver
# =============================================================================
export NVD_LOG=1                                # Used to control logging. 1 to log to stdout, anything else to append to the given file
export NVD_BACKEND=direct                       # Controls which backend this library uses. Either egl, or direct (default)
export LIBVA_DRIVER_NAME=nvidia                 # Force VA-API to use nvidia-vaapi-driver (no auto-detection)
export LIBVA_MESSAGING_LEVEL=0                  # Configure increasing logging verbosity to stdout (0, 1, 2)
# =============================================================================
# NVIDIA Wayland
# =============================================================================
export GBM_BACKEND=nvidia-drm                   # Use NVIDIA's DRM backend for buffer allocation
export __GLX_VENDOR_LIBRARY_NAME=nvidia         # Force GLX to use NVIDIA's library
export __GL_GSYNC_ALLOWED=1                     # Allow G-Sync on supported monitors
export __GL_VRR_ALLOWED=1                       # Allow Variable Refresh Rate (FreeSync/VRR)
# =============================================================================
# Firefox
# =============================================================================
export MOZ_ENABLE_WAYLAND=1                     # Run Firefox natively on Wayland
export MOZ_DISABLE_RDD_SANDBOX=1                # Disables the sandbox for the RDD process that the decoder runs in
export CUDA_DISABLE_PERF_BOOST=1                # Disables the forced power boost the GPU gets when CUDA is activated
# =============================================================================
# Qt / KDE Wayland
# =============================================================================
export QT_QPA_PLATFORM=wayland                  # Use Wayland backend instead of X11
export QT_WAYLAND_FORCE_DRM=1                   # Force DRM buffer sharing (fixes some NVIDIA issues)
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1    # Use server-side decorations (KWin handles them)
export QT_AUTO_SCREEN_SCALE_FACTOR=1            # Enable automatic HiDPI scaling
