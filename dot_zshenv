# Path to your Oh My Zsh installation
export ZSH="$HOME/.oh-my-zsh"

# Set name of the theme to load
export ZSH_THEME="powerlevel10k/powerlevel10k"

# Define cache location for the zsh completion system
export ZCOMP_DUMP_FILE="${HOME}/.zcompdump-${HOST}-${ZSH_VERSION}"

# Powerlevel10k instant prompt cache file
export P10K_INSTANT_PROMPT_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"

# Used to target specific hardware configs
export GPU_SLUG="$(lspci | grep VGA | sed 's/.*: //' | sed 's/ (.*)$//' | tr '[:upper:]' '[:lower:]' | tr -s '[:space:]' '-' | sed 's/[^a-z0-9-]//g' | sed 's/-$//')"

# Disable automatic updates prompt for Oh My Zsh
# https://stackoverflow.com/a/25876379/229787
export DISABLE_AUTO_UPDATE="true"
export DISABLE_UPDATE_PROMPT="true"
export DISABLE_MAGIC_FUNCTIONS="true"
export DISABLE_UNTRACKED_FILES_DIRTY="true"

# Tell GPG which terminal to use for user interaction
export GPG_TTY="$(tty)"

# Language settings (useful for some apps)
export LANG="en_US.UTF-8"
export LC_ALL="$LANG"
export TZ="America/Toronto"

# Set environment variables
export EDITOR='vim'
export VISUAL='vim'
export TERMINAL='kitty'
export BROWSER='firefox'

# Ensure applications know which terminal type is being used
# export TERM="xterm-kitty"

# Node version manager
export NVM_DIR="$HOME/.nvm"

# The QMK CLI makes building and working with QMK keyboards easier.
# We have provided a number of commands to simplify and streamline tasks such as obtaining and compiling the QMK firmware, creating keymaps, and more.
export QMK_HOME="$HOME/qmk_firmware"

# Python version management
export PYENV_COLOR=0
export PYENV_ROOT="$HOME/.pyenv"
export PATH="$PYENV_ROOT/shims:$PATH"

# Add custom scripts directory
export PATH="$HOME/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"
export PATH="/usr/local/bin:$PATH"

# Ollama - Get up and running with large language models.
# Note: by default, ollama only binds to localhost
export OLLAMA_HOST="0.0.0.0:11434"
export OLLAMA_NO_ANALYTICS=1

# ComfyUI
# The most powerful and modular diffusion model GUI, api and backend with a graph/nodes interface.
export COMFYUI_MODEL_PATH="/home/justin/ComfyUI/models"
export COMFYUI_OUTPUT_PATH="/home/justin/ComfyUI/output"
export COMFYUI_TEMP_PATH="/tmp/comfyui"
export COMFYUI_LISTEN="0.0.0.0"
export COMFYUI_PORT=8188
export COMFYUI_ENABLE_CORS="false"
export COMFYUI_AUTO_LAUNCH="false"

# Additional hardware specific configs
[ -f "${HOME}/.zshenv.${GPU_SLUG}" ] && source "${HOME}/.zshenv.${GPU_SLUG}"
