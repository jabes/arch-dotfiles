# Disable automatic updates entirely
zstyle ':omz:update' mode disabled

# Additional completion definitions for Zsh
# https://github.com/zsh-users/zsh-completions
fpath+=($HOME/.zfunc)
fpath+=($ZSH_CUSTOM/plugins/zsh-completions/src)
autoload -U compinit && compinit

# Which plugins would you like to load?
# Add wisely, as too many plugins slow down shell startup.
# Note that zsh-syntax-highlighting must be the last plugin sourced.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

# Run Oh My Zsh
source $ZSH/oh-my-zsh.sh

# A collection of LS_COLORS definitions
# https://github.com/trapd00r/LS_COLORS
source $HOME/.lscolors/lscolors.sh

# Display system info
if command -v fastfetch &>/dev/null
then fastfetch --logo none --pipe --percent-type 1 --structure "OS:Host:Kernel:Uptime:Packages:DE:WM:Shell:Terminal:CPU:GPU:Memory:Disk:Battery" | cowsay -n | lolcat
fi

# Start ssh-agent if not running
if [ -n "$SSH_AUTH_SOCK" ]
then echo "SSH agent already running: $SSH_AUTH_SOCK" | lolcat
else
    eval "$(ssh-agent -s)" >/dev/null
    echo "SSH agent started: $SSH_AGENT_PID" | lolcat
    echo "SSH socket: $SSH_AUTH_SOCK" | lolcat
fi

# Add identities to the authentication agent
ssh-add -l &>/dev/null
if [[ $? -eq 1 ]]
then find "$HOME/.ssh" -type f -name 'id_*' ! -name '*.pub' -exec ssh-add {} \; 2>&1 | lolcat
fi

# Lists fingerprints of all identities currently represented by the agent
ssh-add -l | lolcat

# Simple Python version management
if command -v pyenv &>/dev/null; then
    eval "$(pyenv init -)"
    eval "$(pyenv virtualenv-init -)"
fi

# Node version manager
[[ -s "/usr/share/nvm/init-nvm.sh" ]] && source "/usr/share/nvm/init-nvm.sh"

# Aliases
alias ..="cd .."
alias open="xdg-open"
alias rm="rm --preserve-root=all --verbose"
alias mkdir="mkdir --parents --mode=755 --verbose"
alias ll="ls --all --color=always --classify=always --format=long --group-directories-first --human-readable --sort=name --time=mtime --time-style=long-iso"
alias upgrade="topgrade --cleanup --yes"
