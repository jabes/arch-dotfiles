# Enable Powerlevel10k instant prompt
if [[ -r "$P10K_INSTANT_PROMPT_FILE" ]]
then source "$P10K_INSTANT_PROMPT_FILE"
fi

# Disable automatic updates entirely
zstyle ':omz:update' mode disabled

# Additional completion definitions for Zsh
# https://github.com/zsh-users/zsh-completions
fpath+=($HOME/.zfunc)
fpath+=($ZSH_CUSTOM/plugins/zsh-completions/src)

# Mark function for autoloading
autoload -Uz compinit

# Skip security checks and load completion cache directly
if [[ ! -f ${ZCOMP_DUMP_FILE} ]] || [[ $(find ${ZCOMP_DUMP_FILE} -mtime +1 2>/dev/null) ]]
then compinit
else compinit -C
fi

# Which plugins would you like to load?
# Add wisely, as too many plugins slow down shell startup.
# Note that zsh-syntax-highlighting must be the last plugin sourced.
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

# Run Oh My Zsh
source $ZSH/oh-my-zsh.sh

# A collection of LS_COLORS definitions
# https://github.com/trapd00r/LS_COLORS
source $HOME/.lscolors/lscolors.sh

# Start ssh-agent if not running
if [ -z "$SSH_AUTH_SOCK" ]
then eval "$(ssh-agent -s)" &>/dev/null
fi

# Add identities to the authentication agent
if ! ssh-add -l &>/dev/null
then find "$HOME/.ssh" -type f -name 'id_*' ! -name '*.pub' -exec ssh-add {} \; &>/dev/null
fi

# Only init pyenv in interactive shells, not for system stuff
if [[ -n "$PS1" ]]; then
    eval "$(pyenv init -)"
    eval "$(pyenv virtualenv-init -)"
fi

# Load and unload environment variables depending on the current directory
eval "$(direnv hook zsh)"

# A smarter cd command
eval "$(zoxide init zsh)"

# Run Atuin shell plugin
eval "$(atuin init zsh)"

# Node version manager
[[ -s "/usr/share/nvm/init-nvm.sh" ]] && source "/usr/share/nvm/init-nvm.sh"

# Aliases
alias ..="cd .."
alias open="xdg-open"
alias mysql="mariadb"
alias pbcopy="xclip -selection clipboard"
alias pbpaste="xclip -selection clipboard -o"
alias rm="rm --preserve-root=all --verbose"
alias mkdir="mkdir --parents --mode=755 --verbose"
alias ls="eza --all --group-directories-first --sort=name --icons"
alias ll="eza --all --classify --long --group-directories-first --sort=name --time-style=long-iso --icons --git"
alias upgrade="script --quiet --command 'topgrade --cleanup --yes' /dev/null"
alias sysinfo="fastfetch --logo none --pipe --percent-type 3 --structure OS:Host:Kernel:Uptime:Packages:DE:WM:Shell:Terminal:CPU:GPU:Memory:Disk:Battery"
alias scratch="zeditor $(mktemp ~/scratch/scratch-XXXXXX)"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

